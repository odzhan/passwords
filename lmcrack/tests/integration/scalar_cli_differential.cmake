if(NOT DEFINED LMCRACK_EXE)
  message(FATAL_ERROR "LMCRACK_EXE required")
endif()
if(NOT DEFINED TEST_VERSION)
  set(TEST_VERSION 5)
endif()
function(check password hash start end threads)
  execute_process(COMMAND "${LMCRACK_EXE}" "${hash}" -v1 -v4 "-v${TEST_VERSION}" -v6
    -c 0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ -s "${start}" -e "${end}" -t "${threads}"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 30)
  string(REGEX MATCHALL "found password : ${password}(\r|\n)" matches "${output}")
  list(LENGTH matches count)
  if(NOT result EQUAL 0 OR NOT count EQUAL 4)
    message(FATAL_ERROR "${password}: expected agreement of v1/v4/v5/v6: ${result}\n${output}\n${error}")
  endif()
endfunction()
